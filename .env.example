ANTHROPIC_API_KEY=

# Set to true while developing/testing to use claude-haiku-4-5 instead of
# claude-opus-4-8 (roughly 5x cheaper per token).
USE_CHEAP_MODEL=false

# Publisher safety switch -- keep true until TikTok API credentials are set
# up and you've manually reviewed videos. false actually posts to TikTok.
PUBLISH_DRY_RUN=true

# TikTok Developer app credentials (Basic Information / Credentials tab).
# TIKTOK_CLIENT_SECRET is a real secret -- never share it in chat, never commit it.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
